<!DOCTYPE html>
<html lang="en">
<head>
    
    <link rel="icon" type="image/x-icon" href="\Images\AtlasIcon_20260807010215115.png" />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Atlas</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TaskManager1.styles.css" asp-append-version="true" />


</head>

<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-black border-bottom box-shadow mb-6">
        <div class="container-fluid" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">


          
   
            <ul class="navbar-nav" style="display: flex; gap: 3rem; font-size: 1rem; align-items: center; list-style: none; margin: 0; padding: 0; justify-content: flex-start;">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="text-muted me-2">@User.Identity.Name</span>
    
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-danger">Administrator</span>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <span class="badge bg-warning text-dark">Manager</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">User</span>
                    }
                }
                <li class="nav-item"><a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-area="" asp-controller="Inventory" asp-action="Index">Inventory</a></li>
                <li class="nav-item"><a class="nav-link text-white" asp-area="" asp-controller="Tasks" asp-action="Index">Task Dashboard</a></li>
            </ul>
            <div style="flex: 1; display: flex; justify-content: flex-end;">
                <partial name="_LoginPartial" />
            </div>

        </div>
    </nav>
</header>
    <div class="container">
<main role="main" class="pb-3">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @RenderBody()
</main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Atlas - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>s
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
