@using TaskManager1.Models;
@model IEnumerable<TaskModel>

<div class="text-center">
<ul class="header" style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; font-size: 4.0rem; list-style: none; margin: 0; padding: 0;">
    <h2 style="margin: 0; font-size: 3.0rem; opacity: 0.85;">Current Tasks</h2>
</ul>
<div style="margin-top: 1rem;">
        <a asp-action="Create" class="btn btn-primary">Create Task</a>
    </div>
</div>



    @if (TempData["SuccessMessage"] != null)
{
    <div id="success-alert" class="alert alert-success alert-dismissible fade show text-center" role="alert" style="margin-top: 1.5rem;">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


    <table class="table table-hover table-bordered mt-4">

        <thead class="table-dark">
            <tr>
                <th>TaskId</th>
                <th>SKUs</th>
                <th>EmployeeAssigned</th>
                <th>Bin</th>
                <th>Needs Reconciliation?</th>
                <th>Is Complete?</th>
                <th>Actions</th>


            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {

             <tr>
                <td>@task.TaskId</td>
                <td>@task.SKUs</td>
                <td>@task.EmployeeAssigned</td>
                <td>@task.Bin</td>
                <td>@task.Status</td>
                <td>
                    <form asp-action="CompleteTask" asp-route-id="@task.TaskId" method="post" style="display:inline;">
                        <input type="checkbox" 
                               class="form-check-input complete-checkbox" 
                               onchange="confirmCompletion(this, @task.TaskId)" />
                    </form>
                </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@task.TaskId" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@task.TaskId" class="btn btn-sm btn-danger">Delete</a>
                    </td>

            </tr>

            }

        </tbody>
    </table>
</div>

<script>
    function confirmCompletion(checkbox, taskId) {
        if (checkbox.checked) {
   
            var userConfirmed = confirm("Are you sure this task is really complete?");
            
            if (userConfirmed) {

                checkbox.form.submit();
            } else {

                checkbox.checked = false;
            }
        }
    }
</script>