@using TaskManager1.Models;

@model IEnumerable<TaskModel>

<h1>Task Dashboard</h1>
<h2>Current Task</h2>

<a href="/Tasks/Create" class="btn btn-outline-dark">Create Task</a>


@foreach (var task in Model)
{
    <div>
    <p></p>


    <p>@task.TaskId - @task.Name - @task.Description - @task.DueDate - @task.IsComplete</p>
    <p></p>
    <a href="/Tasks/Edit/@(task.TaskId)" class="btn btn-primary">Edit</a>
    <a href="/Tasks/Delete/@(task.TaskId)" class="btn btn-primary">Delete</a>


    <p></p>
    </div>

}