@model TaskManager1.Models.TaskModel

<h1>Create Task</h1>

<form asp-controller="Tasks" asp-action="Create" method="post">
   

    <div>
        <label asp-for="SKUs"></label>
        <input asp-for="SKUs" class="form-control" />
    </div>

    <div>
        <label asp-for="EmployeeAssigned"></label>
        <input asp-for="EmployeeAssigned" class="form-control" />
    </div>

    <div>
        <label asp-for="Bin"></label>
        <input asp-for="Bin" type="checkbox" />
    </div>

    <button type="submit" class="btn btn-primary">Add Task</button>
</form>